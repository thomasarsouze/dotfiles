#!/bin/bash

set -e

# Vérifier la présence de GPG
command -v gpg >/dev/null 2>&1 || {
    echo "Erreur : GPG introuvable."
    exit 1
}

# Indiquer à GPG le terminal courant
export GPG_TTY="$(tty)"
# Actualiser le terminal utilisé par l'agent GPG
gpg-connect-agent updatestartuptty /bye >/dev/null

# Déchiffrer les secrets et exporter les variables
TMP_SECRETS=$(mktemp)

gpg --quiet --yes --output "$TMP_SECRETS" --decrypt "$HOME/.secrets.gpg"

# Chargement des variables d'environnement
set -a
source "$TMP_SECRETS"
set +a

# Vérifier la présence de la clé Albert
if [[ -z "${ALBERT_API_KEY:-}" ]]; then
    echo "Erreur : ALBERT_API_KEY absente."
    exit 1
fi

echo "Secrets GPG chargés."
echo "ALBERT_API_KEY présente."

# Démarrer OpenCode avec les variables chargées
exec opencode "$@"
